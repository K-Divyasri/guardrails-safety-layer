# Copy this to ".env" and add ONE key ONLY if you want the optional --llm
# classifier. The whole project works WITHOUT any key (the regex/rule guards are
# the default). .env is git-ignored, so your key never leaves your machine.

# Free tier, the default. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Other providers LiteLLM understands:
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optionally override the classifier model (a LiteLLM model string):
# SAFEGUARD_MODEL=gemini/gemini-1.5-flash
